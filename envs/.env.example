## Example environment variables for TechCareerFit
# Copy this to a file named `.env` in the project root and fill values

# Database (Postgres)
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# JWT / Auth
JWT_SECRET_KEY=replace_with_secure_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Supabase (storage for CVs / files)
SUPABASE_URL=https://your-supabase-url
SUPABASE_KEY=your-supabase-key

# Optional: Tesseract path for OCR (Windows example)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Other optional settings
# LOG_LEVEL=info
